{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-stack.invalid/schemas/profile.schema.json",
  "title": "Local AI Stack profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "hardware",
    "services",
    "features",
    "models",
    "runtime"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "ui": { "$ref": "#/$defs/ui" },
    "hardware": { "$ref": "#/$defs/hardware" },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/service" }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "models": { "$ref": "#/$defs/models" },
    "workflows": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/workflow" }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  },
  "$defs": {
    "modelId": {
      "type": "string",
      "pattern": "^(ollama|comfyui)/[a-z][a-z0-9._-]*$"
    },
    "modelIdOrTbd": {
      "oneOf": [
        { "$ref": "#/$defs/modelId" },
        { "const": "TBD" }
      ]
    },
    "models": {
      "type": "object",
      "additionalProperties": { "type": "object" },
      "properties": {
        "chat": {
          "type": "object",
          "properties": {
            "primary": { "$ref": "#/$defs/modelIdOrTbd" },
            "alternatives": {
              "type": "array",
              "items": { "$ref": "#/$defs/modelId" }
            },
            "params": {
              "type": "object",
              "additionalProperties": { "type": ["boolean", "integer", "number", "string"] }
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "diffusion": { "$ref": "#/$defs/modelIdOrTbd" },
            "text_encoder": { "$ref": "#/$defs/modelIdOrTbd" },
            "vae": { "$ref": "#/$defs/modelIdOrTbd" }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_pet": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "default_theme": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_-]*$"
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "gpu_vendor",
        "min_vram_gb",
        "recommended_vram_gb"
      ],
      "properties": {
        "os": { "const": "windows" },
        "gpu_vendor": { "const": "nvidia" },
        "min_vram_gb": { "type": "integer", "minimum": 1 },
        "recommended_vram_gb": { "type": "integer", "minimum": 1 },
        "vram_tolerance_mib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024,
          "default": 0
        },
        "notes": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
        "steps": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
