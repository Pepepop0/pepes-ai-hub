{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-stack.invalid/schemas/profile.schema.json",
  "title": "Local AI Stack profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "hardware",
    "services",
    "features",
    "models",
    "runtime"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "hardware": { "$ref": "#/$defs/hardware" },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/service" }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "models": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/workflow" }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  },
  "$defs": {
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "gpu_vendor",
        "min_vram_gb",
        "recommended_vram_gb"
      ],
      "properties": {
        "os": { "const": "windows" },
        "gpu_vendor": { "const": "nvidia" },
        "min_vram_gb": { "type": "integer", "minimum": 1 },
        "recommended_vram_gb": { "type": "integer", "minimum": 1 },
        "vram_tolerance_mib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024,
          "default": 0
        },
        "notes": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
